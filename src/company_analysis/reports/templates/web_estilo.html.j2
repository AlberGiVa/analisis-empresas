{# Styles of the public website. "Luceiro" (default) is the identity of docs/muestra-luceiro-capital.html;
   "Terminal" and "Prensa" are alternatives the viewer picks on the Configuración page. Preferences are
   attributes on <html> (data-estilo, data-theme, data-densidad, data-texto) saved in localStorage. #}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Albert+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&family=Marcellus&family=Playfair+Display:wght@600;700&family=Source+Serif+4:wght@400;600&display=swap">
<script>
  (function () {  /* apply the saved preferences before the page is painted */
    var root = document.documentElement;
    function get(key) { try { return localStorage.getItem(key); } catch (e) { return null; } }
    var tema = get("luceiro-tema"), estilo = get("luceiro-estilo");
    if (tema === "light" || tema === "dark") root.setAttribute("data-theme", tema);
    if (estilo === "terminal" || estilo === "prensa") root.setAttribute("data-estilo", estilo);
    if (get("luceiro-densidad") === "compacta") root.setAttribute("data-densidad", "compacta");
    if (get("luceiro-texto") === "grande") root.setAttribute("data-texto", "grande");
  })();
</script>
<style>
  :root {
    color-scheme: light;
    --brand: #02613c;
    --bg: #f2f5f2; --surface: #ffffff; --soft: #f7f9f7; --text: #0f1d16; --ink-2: #43534a;
    --muted: #5f6f66; --line: #dbe3dd; --line-strong: #c2cec6;
    --accent: #02613c; --accent-soft: #e2efe7;
    --warn-bg: #fdf1d8; --warn-text: #7f5600; --bad-bg: #fbe8e8; --bad-text: #a52a2a;
    --ok-bg: #e2efe7; --ok-text: #0b6b2f; --warning: #fab219;
    --chart-grid: #e6ece8; --chart-median: #a9bdb1; --chart-dot: #0e7c4e;
    --hero-bg: #02613c; --hero-ink: #ffffff; --hero-ink-2: #cfe5d8; --hero-line: rgba(255, 255, 255, 0.42);
    --shadow: 0 1px 2px rgba(15, 29, 22, 0.05), 0 12px 32px -20px rgba(15, 29, 22, 0.4);
    --font-display: "Marcellus", "Palatino Linotype", Georgia, serif;
    --font-body: "Albert Sans", "Segoe UI", system-ui, sans-serif;
    --font-mono: "IBM Plex Mono", Consolas, ui-monospace, monospace;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      color-scheme: dark;
      --bg: #0b1410; --surface: #111c16; --soft: #16231c; --text: #e5eee8; --ink-2: #aebcb3;
      --muted: #8d9d94; --line: #213229; --line-strong: #2e4337;
      --accent: #6fcb9c; --accent-soft: #16301f;
      --warn-bg: #3a2c10; --warn-text: #f3c66d; --bad-bg: #3a1919; --bad-text: #f07a7a;
      --ok-bg: #16301f; --ok-text: #4cc36a;
      --chart-grid: #1c2b23; --chart-median: #3f5a4b; --chart-dot: #2e9e6a;
      --hero-bg: #034a2f; --hero-ink-2: #bcd9c8; --hero-line: rgba(255, 255, 255, 0.32);
      --shadow: 0 1px 2px rgba(0, 0, 0, 0.3), 0 12px 32px -20px rgba(0, 0, 0, 0.8);
    }
  }
  :root[data-theme="dark"] {
    color-scheme: dark;
    --bg: #0b1410; --surface: #111c16; --soft: #16231c; --text: #e5eee8; --ink-2: #aebcb3;
    --muted: #8d9d94; --line: #213229; --line-strong: #2e4337;
    --accent: #6fcb9c; --accent-soft: #16301f;
    --warn-bg: #3a2c10; --warn-text: #f3c66d; --bad-bg: #3a1919; --bad-text: #f07a7a;
    --ok-bg: #16301f; --ok-text: #4cc36a;
    --chart-grid: #1c2b23; --chart-median: #3f5a4b; --chart-dot: #2e9e6a;
    --hero-bg: #034a2f; --hero-ink-2: #bcd9c8; --hero-line: rgba(255, 255, 255, 0.32);
    --shadow: 0 1px 2px rgba(0, 0, 0, 0.3), 0 12px 32px -20px rgba(0, 0, 0, 0.8);
  }

  body { font-family: var(--font-body); font-size: 15px; line-height: 1.55; -webkit-font-smoothing: antialiased; }
  h1, h2 { font-family: var(--font-display); font-weight: 400; text-wrap: balance; }
  h1 { font-size: clamp(28px, 3.2vw, 38px); line-height: 1.15; margin: 6px 0 10px; }
  h2 { font-size: 24px; line-height: 1.2; margin: 36px 0 12px; border-bottom: 1px solid var(--line); }
  .eyebrow { color: var(--accent); font-weight: 600; letter-spacing: 0.16em; font-size: 12px; }
  code, .formula { font-family: var(--font-mono); }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px; }
  table { background: var(--surface); border: 1px solid var(--line); border-radius: 10px;
          border-collapse: separate; border-spacing: 0; overflow: hidden; }
  tbody tr:last-child > td { border-bottom: 0; }
  .card, .company { background: var(--surface); border-radius: 12px; }
  .disclaimer { background: var(--surface); border-left-color: var(--brand); border-radius: 0 10px 10px 0; }

  /* Index on the left with the logo; a bar on top on narrow screens */
  .shell { display: grid; grid-template-columns: 252px minmax(0, 1fr); min-height: 100vh; }
  .side { position: sticky; top: 0; align-self: start; height: 100vh; overflow-y: auto; z-index: 20;
          display: flex; flex-direction: column; gap: 20px; padding: 24px 18px;
          background: var(--surface); border-right: 1px solid var(--line); }
  .logo-plate { display: block; background: #ffffff; border-radius: 8px; padding: 10px;
                box-shadow: inset 0 0 0 1px var(--line); }  /* the logo always sits on white */
  .logo-plate img { display: block; width: 100%; height: auto; }
  .side-kicker { margin: 0; font-size: 12px; font-weight: 600; letter-spacing: 0.14em;
                 text-transform: uppercase; color: var(--muted); }
  .nav { display: flex; flex-direction: column; gap: 2px; margin-top: -8px; }
  .nav a { display: block; padding: 7px 10px; border-radius: 6px; color: var(--ink-2);
           text-decoration: none; font-size: 15px; }
  .nav a:hover { background: var(--soft); color: var(--text); }
  .nav a[aria-current="page"] { background: var(--accent-soft); color: var(--accent); font-weight: 600; }
  .side-foot { margin-top: auto; display: flex; flex-direction: column; gap: 12px; font-size: 13px; color: var(--muted); }
  .side-foot p { margin: 0; }
  .theme { display: inline-flex; align-self: flex-start; padding: 2px; border-radius: 999px;
           border: 1px solid var(--line); background: var(--soft); }
  .theme button { border: 0; background: transparent; color: var(--ink-2); font: inherit; font-size: 13px;
                  padding: 4px 10px; border-radius: 999px; cursor: pointer; }
  .theme button[aria-pressed="true"] { background: var(--surface); color: var(--text); box-shadow: 0 0 0 1px var(--line-strong); }
  .content { min-width: 0; }
  .content > main { max-width: 1200px; margin: 0 auto;
                    padding: 28px max(clamp(16px, 4vw, 48px), env(safe-area-inset-right, 0px)) 56px
                             max(clamp(16px, 4vw, 48px), env(safe-area-inset-left, 0px)); }
  .site-notice { margin: 0; padding: 10px max(clamp(16px, 4vw, 48px), env(safe-area-inset-right, 0px))
                 10px max(clamp(16px, 4vw, 48px), env(safe-area-inset-left, 0px));
                 background: var(--accent-soft); color: var(--text); font-size: 13.5px; border-bottom: 1px solid var(--line); }
  @media (max-width: 1060px) {
    .shell { grid-template-columns: minmax(0, 1fr); }
    .side { position: sticky; top: 0; height: auto; flex-direction: row; align-items: center; gap: 14px;
            overflow: visible; padding: 10px max(16px, env(safe-area-inset-right, 0px)) 10px max(16px, env(safe-area-inset-left, 0px));
            border-right: 0; border-bottom: 1px solid var(--line); }
    .logo-plate { width: 96px; flex: none; padding: 4px; }
    .side-kicker, .side-foot p { display: none; }
    .nav { flex-direction: row; flex: 1; min-width: 0; margin: 0; overflow-x: auto; scrollbar-width: none; }
    .nav a { white-space: nowrap; font-size: 14px; }
    .side-foot { margin: 0; flex: none; }
  }
  @media (max-width: 640px) {
    .side { flex-wrap: wrap; row-gap: 8px; }
    .nav { order: 3; flex-basis: 100%; }
    .side-foot { margin-left: auto; }
  }
  @media print { .side, .site-notice { display: none; } .shell { display: block; } }
  .lang { font-weight: 600; text-decoration: none; }

  /* ---------- Preferences: density and text size (every style) ---------- */
  :root[data-densidad="compacta"] th, :root[data-densidad="compacta"] td { padding: 3px 7px; font-size: 13px; line-height: 1.35; }
  :root[data-densidad="compacta"] .tile, :root[data-densidad="compacta"] .company { padding: 12px 14px; }
  :root[data-densidad="compacta"] h2 { margin-top: 26px; }
  :root[data-texto="grande"] .content { zoom: 1.12; }

  /* ---------- Style "Terminal": financial data terminal, always dark ---------- */
  :root[data-estilo="terminal"] {
    color-scheme: dark;
    --brand: #ff9e1b;
    --bg: #000000; --surface: #0d0d0d; --soft: #161616; --text: #f2f2f2; --ink-2: #c9c9c9;
    --muted: #8c8c8c; --line: #2b2b2b; --line-strong: #3d3d3d;
    --accent: #ff9e1b; --accent-soft: #2a1c05;
    --warn-bg: #2d2000; --warn-text: #ffc94d; --bad-bg: #2e0b0b; --bad-text: #ff6b6b;
    --ok-bg: #0b2410; --ok-text: #4fdc6a; --warning: #ffc94d;
    --chart-grid: #1f1f1f; --chart-median: #5a5a5a; --chart-dot: #ff9e1b;
    --hero-bg: #0d0d0d; --hero-ink: #ff9e1b; --hero-ink-2: #d9d9d9; --hero-line: rgba(255, 158, 27, 0.55);
    --shadow: none;
    --font-display: "IBM Plex Mono", Consolas, ui-monospace, monospace;
    --font-body: "IBM Plex Sans", "Segoe UI", system-ui, sans-serif;
    --font-mono: "IBM Plex Mono", Consolas, ui-monospace, monospace;
  }
  [data-estilo="terminal"] body { font-size: 14px; }
  [data-estilo="terminal"] h1, [data-estilo="terminal"] h2 { font-weight: 600; text-transform: uppercase; letter-spacing: 0.02em; }
  [data-estilo="terminal"] h1 { font-size: clamp(22px, 2.4vw, 30px); color: var(--accent); }
  [data-estilo="terminal"] h2 { font-size: 17px; color: var(--accent); border-bottom: 1px solid var(--accent); }
  [data-estilo="terminal"] h3 { font-family: var(--font-mono); text-transform: uppercase; font-size: 14px; letter-spacing: 0.04em; }
  [data-estilo="terminal"] :is(.hero-card, .mini, .mini-number, .tile, .list, .facts, table, .card, .company,
    .disclaimer, .btn, .chip, .theme, .theme button, .nav a, .two-views > div, .logo-plate, .badge) { border-radius: 2px; }
  [data-estilo="terminal"] .content { border-top: 3px solid var(--accent); }
  [data-estilo="terminal"] .side { border-right-color: var(--accent); }
  [data-estilo="terminal"] .nav { counter-reset: tecla; }
  [data-estilo="terminal"] .nav a { font-family: var(--font-mono); text-transform: uppercase; font-size: 13px; letter-spacing: 0.04em; }
  [data-estilo="terminal"] .nav a::before { counter-increment: tecla; content: "F" counter(tecla); display: inline-block;
    min-width: 2.6em; margin-right: 6px; color: var(--muted); }
  [data-estilo="terminal"] .nav a[aria-current="page"] { background: var(--accent); color: #000000; }
  [data-estilo="terminal"] .nav a[aria-current="page"]::before { color: #000000; }
  [data-estilo="terminal"] .site-notice { background: var(--accent-soft); color: var(--accent); font-family: var(--font-mono); font-size: 12.5px; }
  [data-estilo="terminal"] th { background: #1a1a1a; color: var(--accent); font-family: var(--font-mono); text-transform: uppercase;
    letter-spacing: 0.05em; font-size: 11.5px; }
  [data-estilo="terminal"] td { font-family: var(--font-mono); font-size: 12.5px; }
  [data-estilo="terminal"] th { font-size: 11px; }
  [data-estilo="terminal"] .hero-card h1 { font-size: clamp(28px, 3.4vw, 44px); line-height: 1.12; }
  [data-estilo="terminal"] tbody tr:nth-child(even) > td { background: #070707; }
  [data-estilo="terminal"] .num, [data-estilo="terminal"] .fact b, [data-estilo="terminal"] .mini-number .v { font-family: var(--font-mono); }
  [data-estilo="terminal"] .eyebrow { font-family: var(--font-mono); color: var(--accent); }
  [data-estilo="terminal"] .hero-card { border: 1px solid var(--accent); }
  [data-estilo="terminal"] .hero-card h1 { color: var(--hero-ink); }
  [data-estilo="terminal"] .btn-light { background: var(--accent); color: #000000; }
  [data-estilo="terminal"] .btn-ghost { color: var(--accent); }
  [data-estilo="terminal"] .mini { border: 1px solid var(--line-strong); box-shadow: none; }
  [data-estilo="terminal"] .disclaimer { border-left-color: var(--accent); }
  [data-estilo="terminal"] .theme { display: none; }  /* always dark */

  /* ---------- Style "Prensa": financial newspaper on salmon paper ---------- */
  :root[data-estilo="prensa"] {
    color-scheme: light;
    --brand: #7d1a3a;
    --bg: #f7ece0; --surface: #fbf5ee; --soft: #f1e3d4; --text: #26211d; --ink-2: #4a423b;
    --muted: #6e6359; --line: #e2d2c1; --line-strong: #cdb8a3;
    --accent: #7d1a3a; --accent-soft: #f1dde2;
    --warn-bg: #f8e6c4; --warn-text: #7a4b00; --bad-bg: #f6dada; --bad-text: #9c1c1c;
    --ok-bg: #dfeadf; --ok-text: #285f2c; --warning: #c47f00;
    --chart-grid: #eadccd; --chart-median: #b9a48e; --chart-dot: #1f4e79;
    --hero-bg: #1f2a44; --hero-ink: #fbf5ee; --hero-ink-2: #d9cfc4; --hero-line: rgba(251, 245, 238, 0.45);
    --shadow: none;
    --font-display: "Playfair Display", Georgia, "Times New Roman", serif;
    --font-body: "Source Serif 4", Georgia, "Times New Roman", serif;
    --font-mono: "IBM Plex Mono", Consolas, ui-monospace, monospace;
  }
  @media (prefers-color-scheme: dark) {
    :root[data-estilo="prensa"]:not([data-theme="light"]) {
      color-scheme: dark;
      --brand: #e58fa6;
      --bg: #1c1814; --surface: #241f1a; --soft: #2c2620; --text: #f1e8dd; --ink-2: #d2c6b8;
      --muted: #a3968a; --line: #3a332c; --line-strong: #4b4239;
      --accent: #e58fa6; --accent-soft: #3a1f28;
      --warn-bg: #3d2d10; --warn-text: #f2c46b; --bad-bg: #3d1a1a; --bad-text: #f39a9a;
      --ok-bg: #1f3322; --ok-text: #8fd49a; --warning: #f2c46b;
      --chart-grid: #2e2822; --chart-median: #6b5d50; --chart-dot: #8fb8e0;
      --hero-bg: #141b2d; --hero-ink: #f1e8dd; --hero-ink-2: #c9bfb3; --hero-line: rgba(241, 232, 221, 0.35);
    }
  }
  :root[data-estilo="prensa"][data-theme="dark"] {
    color-scheme: dark;
    --brand: #e58fa6;
    --bg: #1c1814; --surface: #241f1a; --soft: #2c2620; --text: #f1e8dd; --ink-2: #d2c6b8;
    --muted: #a3968a; --line: #3a332c; --line-strong: #4b4239;
    --accent: #e58fa6; --accent-soft: #3a1f28;
    --warn-bg: #3d2d10; --warn-text: #f2c46b; --bad-bg: #3d1a1a; --bad-text: #f39a9a;
    --ok-bg: #1f3322; --ok-text: #8fd49a; --warning: #f2c46b;
    --chart-grid: #2e2822; --chart-median: #6b5d50; --chart-dot: #8fb8e0;
    --hero-bg: #141b2d; --hero-ink: #f1e8dd; --hero-ink-2: #c9bfb3; --hero-line: rgba(241, 232, 221, 0.35);
  }
  [data-estilo="prensa"] body { font-size: 16px; line-height: 1.6; }
  [data-estilo="prensa"] h1, [data-estilo="prensa"] h2 { font-weight: 700; letter-spacing: -0.01em; }
  [data-estilo="prensa"] h2 { border-bottom: 0; border-top: 3px solid var(--text); padding-top: 8px; }
  [data-estilo="prensa"] :is(.hero-card, .mini, .mini-number, .tile, .list, .facts, table, .card, .company,
    .disclaimer, .btn, .chip, .two-views > div, .badge) { border-radius: 0; }
  [data-estilo="prensa"] .hero-card::before { inset: 8px; border-width: 1px; border-radius: 0; }
  [data-estilo="prensa"] .eyebrow { font-family: var(--font-body); font-weight: 600; letter-spacing: 0.12em; }
  [data-estilo="prensa"] table { border-left: 0; border-right: 0; border-top: 2px solid var(--text); background: transparent; }
  [data-estilo="prensa"] th { background: transparent; color: var(--text); text-transform: uppercase; letter-spacing: 0.06em;
    font-size: 11.5px; border-bottom: 1px solid var(--text); }
  [data-estilo="prensa"] .num, [data-estilo="prensa"] .fact b { font-variant-numeric: tabular-nums lining-nums; }
  [data-estilo="prensa"] .nav a { font-size: 16px; }
  [data-estilo="prensa"] .nav a[aria-current="page"] { background: transparent; color: var(--accent); box-shadow: inset 3px 0 0 var(--accent); border-radius: 0; }
  [data-estilo="prensa"] .side { background: var(--bg); }
  [data-estilo="prensa"] .tile, [data-estilo="prensa"] .list, [data-estilo="prensa"] .company { background: var(--surface); }
  [data-estilo="prensa"] .disclaimer { border-left-color: var(--accent); background: transparent; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  @media (max-width: 1060px) { [data-estilo="prensa"] .nav a[aria-current="page"] { box-shadow: inset 0 -3px 0 var(--accent); } }
</style>
