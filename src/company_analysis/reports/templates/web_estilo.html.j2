{# Styles of the public website: the identity of docs/muestra-luceiro-capital.html. Light or dark mode
   follows the system unless the viewer picks one (data-theme on <html>, saved in localStorage). #}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Albert+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=Marcellus&display=swap">
<script src="{{ site_root }}marca/graficos.js" defer></script>
<script>
  (function () {  /* apply the saved mode before the page is painted */
    var tema = null;
    try { tema = localStorage.getItem("luceiro-tema"); } catch (e) { /* no storage */ }
    if (tema === "light" || tema === "dark") document.documentElement.setAttribute("data-theme", tema);
  })();
</script>
<style>
  :root {
    color-scheme: light;
    --brand: #02613c;
    --bg: #f2f5f2; --surface: #ffffff; --soft: #f7f9f7; --text: #0f1d16; --ink-2: #43534a;
    --muted: #5f6f66; --line: #dbe3dd; --line-strong: #c2cec6;
    --accent: #02613c; --accent-soft: #e2efe7;
    --warn-bg: #fdf1d8; --warn-text: #7f5600; --bad-bg: #fbe8e8; --bad-text: #a52a2a;
    --ok-bg: #e2efe7; --ok-text: #0b6b2f; --warning: #fab219;
    --chart-grid: #e6ece8; --chart-median: #a9bdb1; --chart-dot: #0e7c4e;
    --hero-bg: #02613c; --hero-ink: #ffffff; --hero-ink-2: #cfe5d8; --hero-line: rgba(255, 255, 255, 0.42);
    --shadow: 0 1px 2px rgba(15, 29, 22, 0.05), 0 12px 32px -20px rgba(15, 29, 22, 0.4);
    --font-display: "Marcellus", "Palatino Linotype", Georgia, serif;
    --font-body: "Albert Sans", "Segoe UI", system-ui, sans-serif;
    --font-mono: "IBM Plex Mono", Consolas, ui-monospace, monospace;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      color-scheme: dark;
      --bg: #0b1410; --surface: #111c16; --soft: #16231c; --text: #e5eee8; --ink-2: #aebcb3;
      --muted: #8d9d94; --line: #213229; --line-strong: #2e4337;
      --accent: #6fcb9c; --accent-soft: #16301f;
      --warn-bg: #3a2c10; --warn-text: #f3c66d; --bad-bg: #3a1919; --bad-text: #f07a7a;
      --ok-bg: #16301f; --ok-text: #4cc36a;
      --chart-grid: #1c2b23; --chart-median: #3f5a4b; --chart-dot: #2e9e6a;
      --hero-bg: #034a2f; --hero-ink-2: #bcd9c8; --hero-line: rgba(255, 255, 255, 0.32);
      --shadow: 0 1px 2px rgba(0, 0, 0, 0.3), 0 12px 32px -20px rgba(0, 0, 0, 0.8);
    }
  }
  :root[data-theme="dark"] {
    color-scheme: dark;
    --bg: #0b1410; --surface: #111c16; --soft: #16231c; --text: #e5eee8; --ink-2: #aebcb3;
    --muted: #8d9d94; --line: #213229; --line-strong: #2e4337;
    --accent: #6fcb9c; --accent-soft: #16301f;
    --warn-bg: #3a2c10; --warn-text: #f3c66d; --bad-bg: #3a1919; --bad-text: #f07a7a;
    --ok-bg: #16301f; --ok-text: #4cc36a;
    --chart-grid: #1c2b23; --chart-median: #3f5a4b; --chart-dot: #2e9e6a;
    --hero-bg: #034a2f; --hero-ink-2: #bcd9c8; --hero-line: rgba(255, 255, 255, 0.32);
    --shadow: 0 1px 2px rgba(0, 0, 0, 0.3), 0 12px 32px -20px rgba(0, 0, 0, 0.8);
  }

  body { font-family: var(--font-body); font-size: 15px; line-height: 1.55; -webkit-font-smoothing: antialiased; }
  h1, h2 { font-family: var(--font-display); font-weight: 400; text-wrap: balance; }
  h1 { font-size: clamp(28px, 3.2vw, 38px); line-height: 1.15; margin: 6px 0 10px; }
  h2 { font-size: 24px; line-height: 1.2; margin: 36px 0 12px; border-bottom: 1px solid var(--line); }
  .eyebrow { color: var(--accent); font-weight: 600; letter-spacing: 0.16em; font-size: 12px; }
  code, .formula { font-family: var(--font-mono); }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px; }
  table { background: var(--surface); border: 1px solid var(--line); border-radius: 10px;
          border-collapse: separate; border-spacing: 0; overflow: hidden; }
  tbody tr:last-child > td { border-bottom: 0; }
  .card, .company { background: var(--surface); border-radius: 12px; }
  .disclaimer { background: var(--surface); border-left-color: var(--brand); border-radius: 0 10px 10px 0; }

  /* Index on the left with the logo; a bar on top on narrow screens */
  .shell { display: grid; grid-template-columns: 252px minmax(0, 1fr); min-height: 100vh; }
  .side { position: sticky; top: 0; align-self: start; height: 100vh; overflow-y: auto; z-index: 20;
          display: flex; flex-direction: column; gap: 20px; padding: 24px 18px;
          background: var(--surface); border-right: 1px solid var(--line); }
  .logo-plate { display: block; background: #ffffff; border-radius: 8px; padding: 10px;
                box-shadow: inset 0 0 0 1px var(--line); }  /* the logo always sits on white */
  .logo-plate img { display: block; width: 100%; height: auto; }
  .side-kicker { margin: 0; font-size: 12px; font-weight: 600; letter-spacing: 0.14em;
                 text-transform: uppercase; color: var(--muted); }
  .nav { display: flex; flex-direction: column; gap: 2px; margin-top: -8px; }
  .nav a { display: block; padding: 7px 10px; border-radius: 6px; color: var(--ink-2);
           text-decoration: none; font-size: 15px; }
  .nav a:hover { background: var(--soft); color: var(--text); }
  .nav a[aria-current="page"] { background: var(--accent-soft); color: var(--accent); font-weight: 600; }
  .side-foot { margin-top: auto; display: flex; flex-direction: column; gap: 12px; font-size: 13px; color: var(--muted); }
  .side-foot p { margin: 0; }
  .theme { display: inline-flex; align-self: flex-start; padding: 2px; border-radius: 999px;
           border: 1px solid var(--line); background: var(--soft); }
  .theme button { border: 0; background: transparent; color: var(--ink-2); font: inherit; font-size: 13px;
                  padding: 4px 10px; border-radius: 999px; cursor: pointer; }
  .theme button[aria-pressed="true"] { background: var(--surface); color: var(--text); box-shadow: 0 0 0 1px var(--line-strong); }
  .content { min-width: 0; }
  .content > main { max-width: 1200px; margin: 0 auto;
                    padding: 28px max(clamp(16px, 4vw, 48px), env(safe-area-inset-right, 0px)) 56px
                             max(clamp(16px, 4vw, 48px), env(safe-area-inset-left, 0px)); }
  .site-notice { margin: 0; padding: 10px max(clamp(16px, 4vw, 48px), env(safe-area-inset-right, 0px))
                 10px max(clamp(16px, 4vw, 48px), env(safe-area-inset-left, 0px));
                 background: var(--accent-soft); color: var(--text); font-size: 13.5px; border-bottom: 1px solid var(--line); }
  @media (max-width: 1060px) {
    .shell { grid-template-columns: minmax(0, 1fr); }
    .side { position: sticky; top: 0; height: auto; flex-direction: row; align-items: center; gap: 14px;
            overflow: visible; padding: 10px max(16px, env(safe-area-inset-right, 0px)) 10px max(16px, env(safe-area-inset-left, 0px));
            border-right: 0; border-bottom: 1px solid var(--line); }
    .logo-plate { width: 96px; flex: none; padding: 4px; }
    .side-kicker, .side-foot p { display: none; }
    .nav { flex-direction: row; flex: 1; min-width: 0; margin: 0; overflow-x: auto; scrollbar-width: none; }
    .nav a { white-space: nowrap; font-size: 14px; }
    .side-foot { margin: 0; flex: none; }
  }
  @media (max-width: 640px) {
    .side { flex-wrap: wrap; row-gap: 8px; }
    .nav { order: 3; flex-basis: 100%; }
    .side-foot { margin-left: auto; }
  }
  @media print { .side, .site-notice, .topbar { display: none; } .shell { display: block; } }

  /* Top bar: where the page is and the language selector */
  .topbar { position: sticky; top: 0; z-index: 15; display: flex; align-items: center; justify-content: space-between; gap: 12px;
            padding: 9px max(clamp(16px, 4vw, 48px), env(safe-area-inset-right, 0px)) 9px max(clamp(16px, 4vw, 48px), env(safe-area-inset-left, 0px));
            background: color-mix(in srgb, var(--surface) 90%, transparent); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
            border-bottom: 1px solid var(--line); }
  .crumb { margin: 0; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 12px; font-weight: 600;
           letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  .crumb span { margin: 0 4px; color: var(--line-strong); }
  .lang-switch { display: inline-flex; flex: none; align-items: center; gap: 2px; padding: 3px 3px 3px 10px; border: 1px solid var(--line);
                 border-radius: 999px; background: var(--soft); }
  .lang-switch .globe { fill: none; stroke: var(--muted); stroke-width: 1.2; margin-right: 5px; }
  .lang-opt { padding: 3px 11px; border-radius: 999px; font-size: 12.5px; font-weight: 700; letter-spacing: .06em; line-height: 1.5;
              color: var(--ink-2); text-decoration: none; }
  a.lang-opt:hover { color: var(--text); background: var(--surface); }
  .lang-opt[aria-current] { background: var(--accent); color: var(--surface); }
  @media (max-width: 1060px) { .topbar { position: static; } }

  /* Jumps to the parts of a long page, and the parts' titles */
  .jump { display: flex; flex-wrap: wrap; gap: 6px; margin: 4px 0 2px; }
  .jump a { padding: 4px 12px; border: 1px solid var(--line); border-radius: 999px; background: var(--surface); color: var(--ink-2);
            font-size: 13px; font-weight: 600; text-decoration: none; }
  .jump a:hover { border-color: var(--accent); color: var(--accent); }
  h2.part { margin: 18px 0 -2px; font-size: 26px; }
  [id] { scroll-margin-top: 64px; }
  .map-note { margin: -4px 0 8px; }

  /* ---------- Charts and live data (graficos.js) ---------- */
  :root { --up: var(--ok-text); --down: var(--bad-text); --live: #16a34a; }
  .up { color: var(--up); } .down { color: var(--down); }
  .chart-box { position: relative; min-height: 120px; }
  .chart-svg { display: block; width: 100%; height: auto; touch-action: none; overflow: visible; }
  .chart-grid { stroke: var(--chart-grid); stroke-width: 1; }
  .chart-tick { fill: var(--muted); font-size: 11px; font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
  .chart-line { fill: none; stroke: var(--chart-dot); stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
  .chart-anim { animation: trazo 1.4s cubic-bezier(.2,.7,.2,1) forwards; }
  .chart-line-muted { stroke: var(--chart-median); stroke-width: 1.6; }
  .chart-line-dashed { stroke-dasharray: 5 4; stroke-dashoffset: 0; animation: aparecer .8s ease-out both; }
  .chart-dot { fill: var(--chart-dot); stroke: var(--surface); stroke-width: 2; animation: aparecer .8s .6s ease-out both; }
  .chart-dot-muted { fill: var(--chart-median); }
  .chart-cross { stroke: var(--muted); stroke-width: 1; stroke-dasharray: 3 3; }
  .chart-mark { fill: var(--chart-dot); stroke: var(--surface); stroke-width: 2; }
  .chart-tip { position: absolute; z-index: 5; background: var(--surface); color: var(--text); border: 1px solid var(--line-strong);
               box-shadow: var(--shadow); padding: 6px 10px; border-radius: 6px; font-size: 12px; pointer-events: none;
               white-space: nowrap; font-variant-numeric: tabular-nums; }
  .chart-tip b { display: block; font-size: 11px; color: var(--muted); font-weight: 600; }
  @keyframes trazo { to { stroke-dashoffset: 0; } }
  @keyframes aparecer { from { opacity: 0; } to { opacity: 1; } }
  .spark { display: block; width: 120px; height: 34px; }
  .spark path, .spark polyline { fill: none; stroke: var(--chart-dot); stroke-width: 1.6; stroke-linejoin: round; }
  .more { margin: 10px 0 0; font-weight: 600; } .more a { text-decoration: none; }
  /* TradingView widgets are transparent: without this, Chrome paints a white backdrop behind
     them when the page is dark and the widget document is not. */
  .tv iframe { color-scheme: light; }
  .spark.down path { stroke: var(--down); } .spark.up path { stroke: var(--up); }

  .live { display: inline-flex; align-items: center; gap: 7px; font-size: 12.5px; color: var(--muted); font-weight: 600;
          letter-spacing: .02em; }
  .live::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--muted); }
  .live.en-directo { color: var(--text); }
  .live.en-directo::before { background: var(--live); animation: pulso 1.8s ease-out infinite; }
  @keyframes pulso { 0% { box-shadow: 0 0 0 0 rgba(22,163,74,.55); } 70% { box-shadow: 0 0 0 9px rgba(22,163,74,0); }
                     100% { box-shadow: 0 0 0 0 rgba(22,163,74,0); } }

  .ticker { overflow: hidden; white-space: nowrap; border: 1px solid var(--line); border-radius: 10px; background: var(--surface);
            -webkit-mask-image: linear-gradient(90deg, transparent, #000 3%, #000 97%, transparent);
            mask-image: linear-gradient(90deg, transparent, #000 3%, #000 97%, transparent); }
  .ticker-track { display: inline-flex; gap: 34px; padding: 10px 0; animation: cinta 60s linear infinite; will-change: transform; }
  .ticker:hover .ticker-track { animation-play-state: paused; }
  @keyframes cinta { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  .tk { font-family: var(--font-mono); font-size: 13px; color: var(--ink-2); font-variant-numeric: tabular-nums; }
  .tk b { color: var(--text); margin-right: 4px; }

  .kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 14px; }
  .kpi { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 14px 16px; display: grid;
         grid-template-columns: minmax(0, 1fr) auto; gap: 2px 10px; align-items: end; animation: subir .6s ease-out both; }
  .kpi:nth-child(2) { animation-delay: .08s; } .kpi:nth-child(3) { animation-delay: .16s; } .kpi:nth-child(4) { animation-delay: .24s; }
  .kpi .k-nombre { grid-column: 1 / -1; font-size: 12px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .kpi .k-valor { font-size: 26px; font-weight: 600; line-height: 1.15; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .kpi .k-cambio { font-size: 13px; font-weight: 600; font-variant-numeric: tabular-nums; }
  .kpi .k-fecha { font-size: 11.5px; color: var(--muted); }
  .kpi .k-spark { grid-row: 2 / span 2; grid-column: 2; align-self: center; }
  @keyframes subir { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }

  .heat { display: grid; grid-template-columns: repeat(auto-fill, minmax(118px, 1fr)); gap: 8px; }
  .heat-tile { --fuerza: 0; display: grid; gap: 2px; text-align: left; padding: 10px 12px; border-radius: 10px; cursor: pointer;
               border: 1px solid var(--line); color: var(--text); font: inherit;
               background: color-mix(in srgb, var(--surface), var(--soft) 40%); transition: transform .15s ease, box-shadow .15s ease; }
  .heat-tile.up { background: color-mix(in srgb, var(--up) calc(var(--fuerza) * 22%), var(--surface)); }
  .heat-tile.down { background: color-mix(in srgb, var(--down) calc(var(--fuerza) * 22%), var(--surface)); }
  .heat-tile:hover { transform: translateY(-2px); box-shadow: var(--shadow); }
  .heat-tile[aria-pressed="true"] { outline: 2px solid var(--accent); outline-offset: 1px; }
  .heat-code { font-family: var(--font-mono); font-weight: 600; font-size: 13px; }
  .heat-value { font-size: 17px; font-weight: 600; font-variant-numeric: tabular-nums; }
  .heat-change { font-size: 12.5px; font-weight: 600; font-variant-numeric: tabular-nums; }
  .heat-tile.up .heat-change { color: var(--up); } .heat-tile.down .heat-change { color: var(--down); }

  .seg { display: inline-flex; padding: 2px; border-radius: 8px; border: 1px solid var(--line); background: var(--soft); gap: 2px; }
  .seg button { border: 0; background: transparent; color: var(--ink-2); font: inherit; font-size: 12.5px; font-weight: 600;
                padding: 4px 10px; border-radius: 6px; cursor: pointer; }
  .seg button[aria-pressed="true"] { background: var(--surface); color: var(--accent); box-shadow: 0 0 0 1px var(--line-strong); }
  .panel-card { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 16px 18px; min-width: 0;
                animation: subir .6s ease-out both; }
  .panel-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px 14px; margin-bottom: 10px; }
  .panel-head h2 { margin: 0; padding: 0; border: 0; font-size: 20px; }
  .stats { display: flex; flex-wrap: wrap; gap: 6px 22px; margin: 0 0 8px; font-size: 13px; color: var(--muted); }
  .stats b { color: var(--text); font-variant-numeric: tabular-nums; font-size: 15px; }

  .clocks { display: flex; flex-wrap: wrap; gap: 8px; }
  .clock { display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border-radius: 999px; border: 1px solid var(--line);
           background: var(--surface); font-size: 12.5px; color: var(--muted); }
  .clock::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--muted); }
  .clock.abierto { color: var(--text); }
  .clock.abierto::before { background: var(--live); animation: pulso 1.8s ease-out infinite; }
  .clock .hora { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }

  .bars { display: grid; gap: 6px; }
  .bar-row { display: grid; grid-template-columns: minmax(120px, 1.2fr) 1fr 1fr; gap: 10px; align-items: center; color: var(--text);
             text-decoration: none; padding: 3px 4px; border-radius: 6px; }
  .bar-row:hover { background: var(--soft); }
  .bar-name { font-size: 13px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .bar-track { position: relative; height: 18px; border-radius: 4px; background: var(--soft); overflow: hidden; }
  .bar-fill { position: absolute; inset: 0 auto 0 0; border-radius: 4px; background: var(--chart-dot);
              transform-origin: left; animation: crecer .9s cubic-bezier(.2,.7,.2,1) both; }
  .bar-c .bar-fill { background: var(--chart-median); }
  .bar-value { position: relative; padding-left: 6px; font-size: 11.5px; font-weight: 600; line-height: 18px; color: var(--text);
               font-variant-numeric: tabular-nums; mix-blend-mode: normal; }
  @keyframes crecer { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  .legend { display: flex; gap: 14px; font-size: 12px; color: var(--muted); }
  .legend i { display: inline-block; width: 10px; height: 10px; border-radius: 3px; margin-right: 5px; vertical-align: -1px; background: var(--chart-dot); }
  .legend i.muted { background: var(--chart-median); }
  /* Several series (sovereign yields by country): series 1 is the chart colour of the style */
  :root { --c2: #5f6b78; --c3: #c0812a; --c4: #3b6fb6; }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) { --c2: #a3adb8; --c3: #d9a24e; --c4: #7aa5e6; } }
  :root[data-theme="dark"] { --c2: #a3adb8; --c3: #d9a24e; --c4: #7aa5e6; }
  .chart-line.chart-c2 { stroke: var(--c2); } .chart-line.chart-c3 { stroke: var(--c3); } .chart-line.chart-c4 { stroke: var(--c4); }
  .chart-mark.chart-c2 { fill: var(--c2); } .chart-mark.chart-c3 { fill: var(--c3); } .chart-mark.chart-c4 { fill: var(--c4); }
  .legend i.c1 { background: var(--chart-dot); } .legend i.c2 { background: var(--c2); }
  .legend i.c3 { background: var(--c3); } .legend i.c4 { background: var(--c4); }
  @media (prefers-reduced-motion: reduce) {
    .chart-anim, .chart-dot, .kpi, .panel-card, .bar-fill { animation: none; stroke-dashoffset: 0 !important; }
    .ticker-track { animation: none; }
    .live.en-directo::before, .clock.abierto::before { animation: none; }
  }
</style>
