{% extends "web_base.html.j2" %}
{% block title %}Configuración{% endblock %}
{% block content %}
{# Preferences of this viewer, saved in localStorage and applied as attributes on <html>.
   Every visible label lives in the HTML (the English site translates text nodes only);
   the script only toggles attributes, checked states and the hidden notes. #}
<style>
  .cfg { max-width: 1080px; --cfg-r: 14px; --cfg-r-sm: 10px; --cfg-r-pill: 999px; }
  [data-estilo="terminal"] .cfg { --cfg-r: 2px; --cfg-r-sm: 2px; --cfg-r-pill: 2px; }  /* square, like the style */
  [data-estilo="prensa"] .cfg { --cfg-r: 0px; --cfg-r-sm: 0px; --cfg-r-pill: 2px; }
  .cfg-lead { margin: 0; max-width: 64ch; color: var(--ink-2); font-size: 1.0667em; }
  .cfg-sr { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden;
            clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap; border: 0; }
  /* Layout follows the space actually available (sidebar, text size), hence container queries */
  .cfg-stack { display: grid; gap: 18px; margin-top: 30px; container: cfg-stack / inline-size; }
  .cfg-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  .cfg-card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--cfg-r);
              padding: clamp(18px, 2.6vw, 28px); min-width: 0; container: cfg-card / inline-size; }
  .cfg-head { margin-bottom: 18px; }
  .cfg .cfg-card h2 { margin: 0; padding: 0; border: 0; font-size: 1.4em; line-height: 1.2; }
  .cfg-hint { margin: 6px 0 0; max-width: 62ch; color: var(--ink-2); font-size: 0.9333em; }

  /* Style cards: a radio group whose options carry a small mock-up of each style */
  .cfg-styles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .cfg-style { position: relative; display: block; min-width: 0; cursor: pointer; }
  .cfg-style-face { display: flex; flex-direction: column; height: 100%; padding: 10px;
                    border: 1px solid var(--line); border-radius: var(--cfg-r-sm); background: var(--soft);
                    transition: border-color 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease; }
  .cfg-style:hover .cfg-style-face { border-color: var(--line-strong); box-shadow: var(--shadow); }
  /* --shadow is "none" in some styles, so it is never combined with another shadow */
  .cfg-style input:checked + .cfg-style-face { border-color: var(--accent); background: var(--surface);
                                               box-shadow: inset 0 0 0 1px var(--accent); }
  .cfg-style input:focus-visible + .cfg-style-face { outline: 2px solid var(--accent); outline-offset: 3px; }
  .cfg-style-text { display: block; padding: 14px 6px 6px; }
  .cfg-style-name { position: relative; display: flex; flex-wrap: wrap; align-items: center; gap: 4px 10px;
                    min-height: 22px; padding-right: 32px; color: var(--text); font-weight: 600;
                    font-size: 1.0667em; line-height: 1.3; }
  .cfg-tag { padding: 2px 8px; border-radius: var(--cfg-r-pill); background: var(--accent-soft); color: var(--accent);
             font-size: 0.75rem; font-weight: 600; letter-spacing: 0.02em; white-space: nowrap; }
  .cfg-dot { position: absolute; top: 1px; right: 0; width: 20px; height: 20px; border-radius: 50%;
             border: 1.5px solid var(--line-strong); background: var(--surface);
             transition: background-color 0.15s ease, border-color 0.15s ease; }
  .cfg-style input:checked + .cfg-style-face .cfg-dot { border-color: var(--accent); background: var(--accent);
                                                        box-shadow: inset 0 0 0 4px var(--surface); }
  .cfg-style-desc { display: block; margin-top: 6px; color: var(--ink-2); font-size: 0.9em; line-height: 1.5; }

  /* Mock-ups: each one is drawn with the colours and fonts of its own style, whatever is active */
  .mock { display: block; height: 142px; overflow: hidden; border: 1px solid; border-radius: 8px;
          text-align: left; font-size: 11.5px; line-height: 1.3; text-transform: none; letter-spacing: 0; }
  .mock-bar { display: flex; align-items: center; gap: 8px; height: 24px; padding: 0 10px; }
  .mock-logo { display: block; width: 28px; height: 9px; border-radius: 2px; }
  .mock-live { display: block; width: 6px; height: 6px; border-radius: 50%; }
  .mock-nav { display: flex; gap: 6px; margin-left: auto; }
  .mock-nav i { display: block; width: 16px; height: 4px; border-radius: 2px; }
  .mock-body { display: block; padding: 10px 12px 12px; }
  .mock-title { display: block; font-size: 17px; line-height: 1.15; }
  .mock-sub { display: block; margin-top: 2px; font-size: 10.5px; }
  .mock-table { display: block; margin-top: 9px; border: 1px solid; border-radius: 6px; overflow: hidden; }
  .mock-row { display: grid; grid-template-columns: minmax(0, 1fr) auto 42px; align-items: center; gap: 8px;
              padding: 6px 8px; }
  .mock-row + .mock-row { border-top: 1px solid; }
  .mock-co { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .mock-num { font-weight: 600; font-variant-numeric: tabular-nums; text-align: right; }
  .mock-chip, .mock-down { padding: 1px 0; font-size: 10.5px; font-weight: 600; text-align: center;
                           font-variant-numeric: tabular-nums; }
  .mock-chip { border-radius: 999px; }

  .mock-luceiro { background: #f2f5f2; color: #0f1d16; border-color: #dbe3dd;
                  font-family: "Albert Sans", "Segoe UI", system-ui, sans-serif; }
  .mock-luceiro .mock-bar { background: #02613c; }
  .mock-luceiro .mock-logo { background: #ffffff; }
  .mock-luceiro .mock-nav i { background: rgba(255, 255, 255, 0.55); }
  .mock-luceiro .mock-title { font-family: "Marcellus", "Palatino Linotype", Georgia, serif; font-weight: 400; }
  .mock-luceiro .mock-sub { color: #5f6f66; }
  .mock-luceiro .mock-table { background: #ffffff; border-color: #dbe3dd; }
  .mock-luceiro .mock-row + .mock-row { border-top-color: #dbe3dd; }
  .mock-luceiro .mock-chip { background: #e2efe7; color: #02613c; }
  .mock-luceiro .mock-down { color: #a52a2a; }

  .mock-terminal { background: #000000; color: #f2f2f2; border-color: #2b2b2b;
                   font-family: "IBM Plex Sans", "Segoe UI", system-ui, sans-serif; }
  .mock-terminal .mock-bar { height: 22px; background: #0d0d0d; border-bottom: 1px solid #2b2b2b; }
  .mock-terminal .mock-logo { width: 22px; background: #ff9e1b; border-radius: 0; }
  .mock-terminal .mock-live { background: #4fdc6a; }
  .mock-terminal .mock-nav i { width: 14px; height: 3px; background: #8c8c8c; border-radius: 0; }
  .mock-terminal .mock-title { color: #ff9e1b; font-family: "IBM Plex Mono", Consolas, monospace; font-size: 13px;
                               font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; padding-top: 3px; }
  .mock-terminal .mock-sub { color: #8c8c8c; font-family: "IBM Plex Mono", Consolas, monospace; font-size: 9.5px;
                             letter-spacing: 0.04em; text-transform: uppercase; }
  .mock-terminal .mock-table { background: #0d0d0d; border-color: #2b2b2b; border-radius: 0;
                               font-family: "IBM Plex Mono", Consolas, monospace; font-size: 10.5px; }
  .mock-terminal .mock-row { padding: 5px 8px; }
  .mock-terminal .mock-row + .mock-row { border-top-color: #2b2b2b; background: #161616; }
  .mock-terminal .mock-co { text-transform: uppercase; }
  .mock-terminal .mock-chip { background: #2a1c05; color: #ff9e1b; border-radius: 0; }
  .mock-terminal .mock-down { color: #ff6b6b; }

  .mock-prensa { background: #f7ece0; color: #26211d; border-color: #e2d2c1;
                 font-family: "Source Serif 4", Georgia, "Times New Roman", serif; }
  .mock-prensa .mock-bar { background: #fbf5ee; border-bottom: 3px double #26211d; }
  .mock-prensa .mock-logo { width: 34px; height: 8px; background: #1f2a44; border-radius: 0; }
  .mock-prensa .mock-nav i { height: 3px; background: #6e6359; border-radius: 0; }
  .mock-prensa .mock-title { font-family: "Playfair Display", Georgia, "Times New Roman", serif; font-weight: 700;
                             font-size: 18px; }
  .mock-prensa .mock-sub { color: #6e6359; font-style: italic; }
  .mock-prensa .mock-table { background: transparent; border: 0; border-top: 1px solid #26211d; border-radius: 0; }
  .mock-prensa .mock-row { padding: 5px 2px; }
  .mock-prensa .mock-row + .mock-row { border-top-color: #e2d2c1; }
  .mock-prensa .mock-chip { background: #f1dde2; color: #7d1a3a; border-radius: 2px; }
  .mock-prensa .mock-down { color: #1f2a44; }

  /* Option tiles (mode, density, text size, language): icon on top, label below */
  .cfg-opts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .cfg-opts-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .cfg-opt { position: relative; display: block; min-width: 0; cursor: pointer; }
  .cfg-opt-face, .cfg-langs a[data-lang] {
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px;
    min-height: 88px; height: 100%; padding: 14px 6px 12px; border: 1px solid var(--line); border-radius: var(--cfg-r-sm);
    background: var(--soft); color: var(--ink-2); font-weight: 600; font-size: 0.9333em; line-height: 1.25;
    text-align: center; text-decoration: none; overflow-wrap: break-word; hyphens: auto;
    transition: border-color 0.15s ease, background-color 0.15s ease, color 0.15s ease; }
  .cfg-opt-face svg { width: 24px; height: 24px; flex: none; }
  .cfg-opt:hover .cfg-opt-face, .cfg-langs a[data-lang][href]:hover { border-color: var(--line-strong); color: var(--text); }
  .cfg-opt input:checked + .cfg-opt-face, .cfg-langs a[data-lang][aria-current="true"] {
    border-color: var(--accent); background: var(--accent-soft); color: var(--accent);
    box-shadow: inset 0 0 0 1px var(--accent); }
  .cfg-opt input:focus-visible + .cfg-opt-face { outline: 2px solid var(--accent); outline-offset: 2px; }
  .cfg-opt input:disabled + .cfg-opt-face { opacity: 0.5; cursor: not-allowed; }
  .cfg-opt:has(input:disabled) { cursor: not-allowed; }
  .cfg-aa { display: flex; align-items: flex-end; height: 24px; font-family: var(--font-display); line-height: 1; }
  .cfg-aa-n { font-size: 16px; }
  .cfg-aa-g { font-size: 24px; }
  .cfg-langs a[data-lang]::before {  /* language code as the tile's "icon" (decorative) */
    content: attr(hreflang); content: attr(hreflang) / "";
    display: grid; place-items: center; width: 30px; height: 24px; border-radius: 6px;
    border: 1.5px solid currentColor; font-family: var(--font-mono); font-size: 11px; font-weight: 500;
    letter-spacing: 0.06em; text-transform: uppercase; }
  .cfg-langs a[data-lang][aria-current="true"] { cursor: default; }

  .cfg-note { display: flex; align-items: flex-start; gap: 10px; margin: 14px 0 0; padding: 10px 12px;
              border-radius: var(--cfg-r-sm); background: var(--soft); color: var(--ink-2); font-size: 0.9em; }
  .cfg-note svg { width: 18px; height: 18px; flex: none; margin-top: 1px; color: var(--accent); }
  .cfg-note[hidden] { display: none; }

  /* Defaults and reset */
  .cfg-reset { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 16px 24px; align-items: center; }
  .cfg-btn { display: inline-flex; align-items: center; gap: 8px; padding: 10px 18px; border-radius: var(--cfg-r-sm);
             border: 1px solid var(--line-strong); background: var(--surface); color: var(--text);
             font: inherit; font-weight: 600; cursor: pointer;
             transition: border-color 0.15s ease, color 0.15s ease, background-color 0.15s ease; }
  .cfg-btn svg { width: 18px; height: 18px; flex: none; }
  .cfg-btn:hover { border-color: var(--accent); color: var(--accent); background: var(--accent-soft); }
  .cfg-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .cfg-reset-foot { grid-column: 1 / -1; display: grid; gap: 10px; padding-top: 16px; border-top: 1px solid var(--line); }
  .cfg-reset-foot .cfg-note { margin: 0; }
  .cfg-done { margin: 0; }
  .cfg-done span { display: inline-flex; align-items: center; gap: 8px; margin-top: 12px; padding: 5px 12px;
                   border-radius: var(--cfg-r-pill);
                   background: var(--ok-bg); color: var(--ok-text); font-size: 0.9em; font-weight: 600; }
  .cfg-done span[hidden] { display: none; }
  .cfg-warn { margin: 0; padding: 10px 12px; border-radius: var(--cfg-r-sm); background: var(--warn-bg); color: var(--warn-text);
              font-size: 0.9em; }
  .cfg-warn[hidden] { display: none; }

  @container cfg-stack (max-width: 820px) { .cfg-grid { grid-template-columns: minmax(0, 1fr); } }
  @container cfg-stack (max-width: 480px) {
    .cfg-reset { grid-template-columns: minmax(0, 1fr); }
    .cfg-btn { justify-self: start; }
  }
  /* Style cards: three columns, then one per row with the mock-up beside the text, then stacked */
  @container cfg-card (max-width: 720px) {
    .cfg-styles { grid-template-columns: minmax(0, 1fr); gap: 12px; }
    .cfg-style-face { display: grid; grid-template-columns: minmax(0, 250px) minmax(0, 1fr); align-items: center;
                      column-gap: 18px; }
    .cfg-style-text { padding: 4px 4px 4px 0; }
  }
  @container cfg-card (max-width: 480px) {
    .cfg-style-face { display: flex; }
    .cfg-style-text { padding: 14px 6px 6px; }
  }
  @container cfg-card (max-width: 400px) {
    .cfg-opt-face, .cfg-langs a[data-lang] { min-height: 80px; padding: 12px 6px 10px; }
  }
  /* Three tiles side by side stop fitting their labels: they become rows (icon, then label) */
  @container cfg-card (max-width: 325px) {
    .cfg-opts-3 { grid-template-columns: minmax(0, 1fr); gap: 8px; }
    .cfg-opts-3 .cfg-opt-face { flex-direction: row; justify-content: flex-start; gap: 12px; min-height: 0;
                                padding: 11px 14px; text-align: left; }
  }
  @supports not (container-type: inline-size) {  /* older browsers: the same steps by window width */
    @media (max-width: 1240px) { .cfg-grid { grid-template-columns: minmax(0, 1fr); } }
    @media (max-width: 680px) { .cfg-styles { grid-template-columns: minmax(0, 1fr); } }
    @media (max-width: 520px) {
      .cfg-reset { grid-template-columns: minmax(0, 1fr); }
      .cfg-btn { justify-self: start; }
      .cfg-opts-3 { grid-template-columns: minmax(0, 1fr); }
      .cfg-opts-3 .cfg-opt-face { flex-direction: row; justify-content: flex-start; min-height: 0; padding: 11px 14px; }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cfg-style-face, .cfg-dot, .cfg-opt-face, .cfg-langs a[data-lang], .cfg-btn { transition: none; }
  }
</style>

<div class="cfg" data-config>
  <p class="eyebrow">Preferencias</p>
  <h1>Configuración</h1>
  <p class="cfg-lead">Elige cómo quieres ver esta web. Los cambios se aplican al momento en todas las páginas y se
  recuerdan en este navegador.</p>

  <div class="cfg-stack">
    <section class="cfg-card" aria-labelledby="cfg-estilo-t">
      <div class="cfg-head">
        <h2 id="cfg-estilo-t">Estilo</h2>
        <p class="cfg-hint" id="cfg-estilo-d">Colores y tipografía de toda la web.</p>
      </div>
      <div class="cfg-styles" role="radiogroup" aria-labelledby="cfg-estilo-t" aria-describedby="cfg-estilo-d">
        <label class="cfg-style">
          <input class="cfg-sr" type="radio" name="estilo" value="luceiro" checked
                 aria-labelledby="cfg-luceiro-n" aria-describedby="cfg-luceiro-d">
          <span class="cfg-style-face">
            <span class="mock mock-luceiro" aria-hidden="true">
              <span class="mock-bar"><span class="mock-logo"></span><span class="mock-nav"><i></i><i></i><i></i></span></span>
              <span class="mock-body">
                <span class="mock-title">Ranking</span>
                <span class="mock-sub">Puntuación de accionista</span>
                <span class="mock-table">
                  <span class="mock-row"><span class="mock-co">Empresa A</span><span class="mock-num">72</span><span class="mock-chip">+3</span></span>
                  <span class="mock-row"><span class="mock-co">Empresa B</span><span class="mock-num">58</span><span class="mock-down">−2</span></span>
                </span>
              </span>
            </span>
            <span class="cfg-style-text">
              <span class="cfg-style-name" id="cfg-luceiro-n"><span translate="no">Luceiro</span><span class="cfg-tag">Predeterminado</span><span class="cfg-dot" aria-hidden="true"></span></span>
              <span class="cfg-style-desc" id="cfg-luceiro-d">El verde corporativo de la casa, con tipografía clásica. Claro u oscuro.</span>
            </span>
          </span>
        </label>
        <label class="cfg-style">
          <input class="cfg-sr" type="radio" name="estilo" value="terminal"
                 aria-labelledby="cfg-terminal-n" aria-describedby="cfg-terminal-d">
          <span class="cfg-style-face">
            <span class="mock mock-terminal" aria-hidden="true">
              <span class="mock-bar"><span class="mock-logo"></span><span class="mock-live"></span><span class="mock-nav"><i></i><i></i><i></i><i></i></span></span>
              <span class="mock-body">
                <span class="mock-title">Ranking</span>
                <span class="mock-sub">Puntuación de accionista</span>
                <span class="mock-table">
                  <span class="mock-row"><span class="mock-co">Empresa A</span><span class="mock-num">72</span><span class="mock-chip">+3</span></span>
                  <span class="mock-row"><span class="mock-co">Empresa B</span><span class="mock-num">58</span><span class="mock-down">−2</span></span>
                </span>
              </span>
            </span>
            <span class="cfg-style-text">
              <span class="cfg-style-name" id="cfg-terminal-n"><span>Terminal</span><span class="cfg-dot" aria-hidden="true"></span></span>
              <span class="cfg-style-desc" id="cfg-terminal-d">Inspirado en los terminales de datos financieros: fondo negro, acentos ámbar y letra monoespaciada. Siempre oscuro.</span>
            </span>
          </span>
        </label>
        <label class="cfg-style">
          <input class="cfg-sr" type="radio" name="estilo" value="prensa"
                 aria-labelledby="cfg-prensa-n" aria-describedby="cfg-prensa-d">
          <span class="cfg-style-face">
            <span class="mock mock-prensa" aria-hidden="true">
              <span class="mock-bar"><span class="mock-logo"></span><span class="mock-nav"><i></i><i></i><i></i></span></span>
              <span class="mock-body">
                <span class="mock-title">Ranking</span>
                <span class="mock-sub">Puntuación de accionista</span>
                <span class="mock-table">
                  <span class="mock-row"><span class="mock-co">Empresa A</span><span class="mock-num">72</span><span class="mock-chip">+3</span></span>
                  <span class="mock-row"><span class="mock-co">Empresa B</span><span class="mock-num">58</span><span class="mock-down">−2</span></span>
                </span>
              </span>
            </span>
            <span class="cfg-style-text">
              <span class="cfg-style-name" id="cfg-prensa-n"><span>Prensa</span><span class="cfg-dot" aria-hidden="true"></span></span>
              <span class="cfg-style-desc" id="cfg-prensa-d">Como un diario financiero en papel salmón: letra con serifa y filetes finos.</span>
            </span>
          </span>
        </label>
      </div>
    </section>

    <div class="cfg-grid">
      <section class="cfg-card" aria-labelledby="cfg-modo-t">
        <div class="cfg-head">
          <h2 id="cfg-modo-t">Modo</h2>
          <p class="cfg-hint" id="cfg-modo-d">Automático sigue el ajuste claro u oscuro del dispositivo.</p>
        </div>
        <div class="cfg-opts cfg-opts-3" role="radiogroup" aria-labelledby="cfg-modo-t" aria-describedby="cfg-modo-d" data-mode-group>
          <label class="cfg-opt">
            <input class="cfg-sr" type="radio" name="tema" value="system" checked>
            <span class="cfg-opt-face">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg>
              <span>Automático</span>
            </span>
          </label>
          <label class="cfg-opt">
            <input class="cfg-sr" type="radio" name="tema" value="light">
            <span class="cfg-opt-face">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"/></svg>
              <span>Claro</span>
            </span>
          </label>
          <label class="cfg-opt">
            <input class="cfg-sr" type="radio" name="tema" value="dark">
            <span class="cfg-opt-face">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a6.8 6.8 0 0 0 10.5 10.5z"/></svg>
              <span>Oscuro</span>
            </span>
          </label>
        </div>
        <p class="cfg-note" id="cfg-modo-terminal" data-mode-note hidden>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 7.5v.5"/></svg>
          <span>El estilo Terminal es siempre oscuro.</span>
        </p>
      </section>

      <section class="cfg-card" aria-labelledby="cfg-densidad-t">
        <div class="cfg-head">
          <h2 id="cfg-densidad-t">Densidad de las tablas</h2>
          <p class="cfg-hint" id="cfg-densidad-d">Compacta reduce el espacio entre filas para ver más datos a la vez.</p>
        </div>
        <div class="cfg-opts" role="radiogroup" aria-labelledby="cfg-densidad-t" aria-describedby="cfg-densidad-d">
          <label class="cfg-opt">
            <input class="cfg-sr" type="radio" name="densidad" value="comoda" checked>
            <span class="cfg-opt-face">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3.5" width="18" height="17" rx="2"/><path d="M3 9.5h18M3 15h18"/></svg>
              <span>Cómoda</span>
            </span>
          </label>
          <label class="cfg-opt">
            <input class="cfg-sr" type="radio" name="densidad" value="compacta">
            <span class="cfg-opt-face">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3.5" width="18" height="17" rx="2"/><path d="M3 7.75h18M3 12h18M3 16.25h18"/></svg>
              <span>Compacta</span>
            </span>
          </label>
        </div>
      </section>

      <section class="cfg-card" aria-labelledby="cfg-texto-t">
        <div class="cfg-head">
          <h2 id="cfg-texto-t">Tamaño del texto</h2>
          <p class="cfg-hint" id="cfg-texto-d">Grande aumenta la letra de toda la web.</p>
        </div>
        <div class="cfg-opts" role="radiogroup" aria-labelledby="cfg-texto-t" aria-describedby="cfg-texto-d">
          <label class="cfg-opt">
            <input class="cfg-sr" type="radio" name="texto" value="normal" checked>
            <span class="cfg-opt-face">
              <span class="cfg-aa cfg-aa-n" aria-hidden="true" translate="no">Aa</span>
              <span>Normal</span>
            </span>
          </label>
          <label class="cfg-opt">
            <input class="cfg-sr" type="radio" name="texto" value="grande">
            <span class="cfg-opt-face">
              <span class="cfg-aa cfg-aa-g" aria-hidden="true" translate="no">Aa</span>
              <span>Grande</span>
            </span>
          </label>
        </div>
      </section>

      <section class="cfg-card" aria-labelledby="cfg-idioma-t">
        <div class="cfg-head">
          <h2 id="cfg-idioma-t">Idioma</h2>
          <p class="cfg-hint">Abre esta misma página en el otro idioma.</p>
        </div>
        <nav class="cfg-opts cfg-langs" aria-labelledby="cfg-idioma-t">
          <a href="#cambiar-idioma" data-lang="es" translate="no" hreflang="es">Español</a>
          <a href="#cambiar-idioma" data-lang="en" translate="no" hreflang="en">English</a>
        </nav>
      </section>
    </div>

    <section class="cfg-card cfg-reset" aria-labelledby="cfg-reset-t">
      <div>
        <h2 id="cfg-reset-t">Valores predeterminados</h2>
        <p class="cfg-hint">Estilo Luceiro, modo automático, tablas cómodas y texto normal.</p>
        <p class="cfg-done" role="status"><span data-reset-done hidden>Listo: has vuelto a los valores predeterminados.</span></p>
      </div>
      <button type="button" class="cfg-btn" data-reset>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 12a8.5 8.5 0 1 0 2.6-6.1"/><path d="M3.5 4v5h5"/></svg>
        <span>Restablecer</span>
      </button>
      <div class="cfg-reset-foot">
        <p class="cfg-note">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 7.5v.5"/></svg>
          <span>Las preferencias se guardan solo en este navegador: en otro equipo o navegador verás los valores predeterminados. La página de presentación mantiene siempre su propio diseño.</span>
        </p>
        <p class="cfg-warn" data-storage-off hidden>Este navegador no permite guardar las preferencias: los cambios se aplican a esta página, pero no se recordarán al cambiar de página.</p>
        <noscript><p class="cfg-warn">Para cambiar las preferencias hace falta tener JavaScript activado.</p></noscript>
      </div>
    </section>
  </div>
</div>

<script>
  (function () {
    var root = document.documentElement;
    var page = document.querySelector("[data-config]");
    if (!page) return;
    // localStorage key, allowed values (the first one is the default) and attribute on <html>.
    // The default value removes the attribute; the head script of every page reads the same keys.
    var PREFS = {
      estilo: { key: "luceiro-estilo", values: ["luceiro", "terminal", "prensa"], attr: "data-estilo" },
      tema: { key: "luceiro-tema", values: ["system", "light", "dark"], attr: "data-theme" },
      densidad: { key: "luceiro-densidad", values: ["comoda", "compacta"], attr: "data-densidad" },
      texto: { key: "luceiro-texto", values: ["normal", "grande"], attr: "data-texto" }
    };
    var NAMES = Object.keys(PREFS);
    var modeGroup = page.querySelector("[data-mode-group]");
    var modeNote = page.querySelector("[data-mode-note]");
    var resetDone = page.querySelector("[data-reset-done]");
    var storageOff = page.querySelector("[data-storage-off]");
    var storageWorks = true;

    function load(name) {
      var pref = PREFS[name];
      var value = null;
      try { value = localStorage.getItem(pref.key); } catch (e) { storageWorks = false; }
      return pref.values.indexOf(value) >= 0 ? value : pref.values[0];
    }
    function save(name, value) {
      try { localStorage.setItem(PREFS[name].key, value); } catch (e) { storageWorks = false; }
    }
    function forget(name) {
      try { localStorage.removeItem(PREFS[name].key); } catch (e) { storageWorks = false; }
    }
    function showStorageState() {
      if (storageOff) storageOff.hidden = storageWorks;
    }

    // Apply one preference to <html> and bring every control on the page (and the sidebar) in line.
    function apply(name, value) {
      var pref = PREFS[name];
      if (value === pref.values[0]) root.removeAttribute(pref.attr); else root.setAttribute(pref.attr, value);
      page.querySelectorAll('input[name="' + name + '"]').forEach(function (input) {
        input.checked = input.value === value;
      });
      if (name === "tema") {
        document.querySelectorAll("[data-theme-btn]").forEach(function (button) {
          button.setAttribute("aria-pressed", String(button.getAttribute("data-theme-btn") === value));
        });
      }
      if (name === "estilo") {
        var alwaysDark = value === "terminal";  // the Terminal style has no light mode
        page.querySelectorAll('input[name="tema"]').forEach(function (input) { input.disabled = alwaysDark; });
        if (modeGroup) {
          modeGroup.setAttribute("aria-disabled", String(alwaysDark));
          if (alwaysDark) modeGroup.setAttribute("aria-describedby", "cfg-modo-d cfg-modo-terminal");
          else modeGroup.setAttribute("aria-describedby", "cfg-modo-d");
        }
        if (modeNote) modeNote.hidden = !alwaysDark;
      }
    }

    page.addEventListener("change", function (event) {
      var input = event.target;
      if (!input || !input.name || !PREFS[input.name] || !input.checked) return;
      apply(input.name, input.value);
      save(input.name, input.value);
      if (resetDone) resetDone.hidden = true;
      showStorageState();
    });

    var reset = page.querySelector("[data-reset]");
    if (reset) {
      reset.addEventListener("click", function () {
        NAMES.forEach(function (name) { forget(name); apply(name, PREFS[name].values[0]); });
        if (resetDone) resetDone.hidden = false;
        showStorageState();
      });
    }

    // The sidebar's Auto/Claro/Oscuro buttons save the mode themselves; mirror them here.
    document.querySelectorAll("[data-theme-btn]").forEach(function (button) {
      button.addEventListener("click", function () {
        var value = button.getAttribute("data-theme-btn");
        if (PREFS.tema.values.indexOf(value) >= 0) apply("tema", value);
        if (resetDone) resetDone.hidden = true;
      });
    });

    // Changes made in another tab of this site.
    window.addEventListener("storage", function () {
      NAMES.forEach(function (name) { apply(name, load(name)); });
    });

    // Language: the link of the current language is marked and stops being a link.
    var lang = (root.lang || "").toLowerCase().split("-")[0];
    page.querySelectorAll("a[data-lang]").forEach(function (link) {
      if (link.getAttribute("data-lang") === lang) {
        link.setAttribute("aria-current", "true");
        link.removeAttribute("href");
      }
    });

    try {
      localStorage.setItem("luceiro-prueba", "1");
      localStorage.removeItem("luceiro-prueba");
    } catch (e) { storageWorks = false; }
    NAMES.forEach(function (name) { apply(name, load(name)); });
    showStorageState();
  })();
</script>
{% endblock %}
