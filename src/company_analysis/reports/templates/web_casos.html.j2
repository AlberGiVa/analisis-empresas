{% extends "base.html.j2" %}
{% block title %}Ejemplos · {{ run_date }}{% endblock %}
{% block content %}
<style>
  .lead { max-width: 72ch; margin: 0 0 6px; font-size: 16px; color: var(--ink-2, var(--text)); }
  .howto { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 12px; margin: 22px 0 6px; padding: 0;
           list-style: none; counter-reset: paso; }
  .howto li { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 2px 12px; align-items: start; padding: 12px 14px;
              border: 1px solid var(--line); border-radius: 12px; background: var(--surface, var(--soft)); counter-increment: paso; }
  .howto li::before { content: counter(paso); grid-row: 1 / span 2; display: grid; place-items: center; width: 28px; height: 28px;
                      border-radius: 50%; background: var(--accent); color: var(--surface, #fff); font-weight: 700; font-size: 14px; }
  .howto b { font-size: 14px; }
  .howto span { font-size: 13px; color: var(--muted); }
  .jump { margin-top: 18px; }
  .group { margin-top: 30px; scroll-margin-top: 70px; }
  .group > p { margin: 0 0 14px; max-width: 72ch; color: var(--muted); }
  .cases { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 430px), 1fr)); gap: 16px; }
  .case { display: flex; flex-direction: column; gap: 12px; background: var(--surface, var(--soft)); border: 1px solid var(--line);
          border-radius: 12px; padding: 18px; min-width: 0; }
  .case h3 { margin: 0; font-size: 18px; line-height: 1.25; }
  .case .who { margin: 2px 0 0; font-size: 13px; color: var(--muted); }
  .case .who span + span::before { content: " · "; }
  .steps { display: grid; gap: 10px; margin: 0; }
  .steps div { display: grid; gap: 2px; }
  .step-title { display: flex; align-items: center; gap: 8px; margin: 0; font-size: 11.5px; font-weight: 700;
                letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .steps dd { margin: 0 0 0 30px; }
  .n { display: inline-grid; place-items: center; flex: none; width: 22px; height: 22px; border-radius: 50%;
       border: 1px solid var(--line-strong, var(--line)); font-size: 12px; letter-spacing: 0; color: var(--accent); }
  .proof { border-top: 1px solid var(--line); padding-top: 10px; }
  .proof .step-title { margin-bottom: 4px; }
  table.proof-table { width: 100%; margin: 0; border: 0; border-radius: 0; background: transparent; font-size: 13.5px; }
  table.proof-table th { background: transparent; color: var(--text); font-size: 13.5px; font-weight: 500; padding: 6px 8px 6px 30px; }
  table.proof-table td { padding: 6px 8px; }
  table.proof-table tr.note td { padding: 0 8px 7px 30px; font-size: 12.5px; color: var(--muted); border-bottom: 1px solid var(--line); }
  table.proof-table tr.has-note th, table.proof-table tr.has-note td { border-bottom: 0; }
  .value { font-weight: 600; font-variant-numeric: tabular-nums; }
  .case .go { margin: auto 0 0; font-weight: 600; }
  .case .go a { text-decoration: none; }
  .fineprint { margin-top: 28px; font-size: 13px; color: var(--muted); max-width: 80ch; }
</style>

<header>
  <p class="eyebrow">Ejemplos · empresas ficticias</p>
  <h1>Cómo responde la herramienta en cada situación</h1>
  <p class="lead">Las empresas reales casi nunca tienen todos sus datos completos ni son todas iguales. Estas {{ shown }}
    empresas son inventadas y cada una tiene una situación distinta, para comprobar que la herramienta la trata bien y
    nunca inventa un dato.</p>
</header>

<ol class="howto">
  <li><b>La situación</b><span>Qué tiene de especial la empresa.</span></li>
  <li><b>Lo que hace la herramienta</b><span>Cómo la trata, sin inventar nada.</span></li>
  <li><b>El resultado en su ficha</b><span>Las cifras y los avisos tal como salen.</span></li>
</ol>

<nav class="jump" aria-label="En esta página">
  {% for title, introduction, cases in groups %}<a href="#grupo-{{ loop.index }}">{{ title }}</a>{% endfor %}
</nav>

{% for title, introduction, cases in groups %}
<section class="group" id="grupo-{{ loop.index }}">
  <h2>{{ title }}</h2>
  <p>{{ introduction }}</p>
  <div class="cases">
    {% for case, company, rows in cases %}
    <article class="case">
      <div>
        <h3>{{ case.title }}</h3>
        <p class="who"><span>{{ company.name }}</span><span>{{ company.country }}</span><span>{{ company.industry_label }}</span></p>
      </div>
      <dl class="steps">
        <div><dt class="step-title"><span class="n" aria-hidden="true">1</span>La situación</dt><dd>{{ case.situation }}</dd></div>
        <div><dt class="step-title"><span class="n" aria-hidden="true">2</span>Lo que hace la herramienta</dt><dd>{{ case.response }}</dd></div>
      </dl>
      <div class="proof">
        <p class="step-title"><span class="n" aria-hidden="true">3</span>El resultado en su ficha</p>
        <table class="proof-table">
          {% for row in rows %}
          <tr{% if row.note %} class="has-note"{% endif %}>
            <th scope="row">{{ row.label }}</th>
            <td class="num">{% if row.state %}<span class="badge">{{ row.state }}</span>{% elif row.alert %}<span class="badge badge-fail">{{ row.value }}</span>{% else %}<span class="value">{{ row.value }}</span>{% endif %}</td>
          </tr>
          {% if row.note %}<tr class="note"><td colspan="2">{{ row.note }}</td></tr>{% endif %}
          {% endfor %}
        </table>
      </div>
      <p class="go"><a href="{{ company.ficha_path }}">Abrir la ficha completa →</a></p>
    </article>
    {% endfor %}
  </div>
</section>
{% endfor %}

<p class="fineprint">Datos inventados. Las puntuaciones comparan cada empresa con las {{ total }} del conjunto de ejemplo, aunque
  aquí solo aparecen las {{ shown }} que muestran un caso. <a href="ranking.html">Ranking de los casos</a> ·
  <a href="ranking.csv">CSV para Excel</a></p>
{% endblock %}
