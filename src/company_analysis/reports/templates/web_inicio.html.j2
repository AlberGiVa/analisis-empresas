{% extends "web_base.html.j2" %}
{% block title %}Panel · Luceiro Capital{% endblock %}
{% block content %}
<style>
  .facts { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1px; margin: 18px 0 22px;
           background: var(--line); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
  .fact { background: var(--surface); padding: 14px 18px; }
  .fact b { display: block; font-size: 28px; font-weight: 600; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .fact span { display: block; font-size: 13px; color: var(--ink-2); margin-top: 4px; }
  .board { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: 18px; }
  .tile { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 16px 18px; min-width: 0; }
  .tile-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin-bottom: 6px; }
  .tile-head h2 { margin: 0; padding: 0; border: 0; font-size: 20px; }
  .tile-head a { font-weight: 600; text-decoration: none; white-space: nowrap; }
  .tile table { border: 0; margin: 0; }
  .tile td, .tile th { font-size: 13.5px; }
  .tile .code { font-family: var(--font-mono); font-weight: 600; }
  .up { color: var(--ok-text); }
  .down { color: var(--bad-text); }
  .spark { width: 110px; height: 28px; display: block; }
  .spark polyline { fill: none; stroke: var(--chart-dot); stroke-width: 1.6; stroke-linejoin: round; }
  .alert-list { list-style: none; margin: 0; padding: 0; }
  .alert-list li { padding: 9px 0; border-bottom: 1px solid var(--line); font-size: 13.5px; }
  .alert-list li:last-child { border-bottom: 0; }
  .stack { display: grid; gap: 18px; min-width: 0; align-content: start; }
  @media (max-width: 980px) { .board { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 700px) { .facts { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>

<p class="eyebrow">Luceiro Capital · Fondo multiactivos</p>
<h1>Panel</h1>
<p class="meta">Actualizado el {{ generated }} · empresas a {{ real_date }}</p>

<div class="facts">
  <div class="fact"><b>{{ study.run.companies | length }}</b><span>Empresas</span></div>
  <div class="fact"><b>{{ real_alerts | length }}</b><span>Alertas</span></div>
  <div class="fact"><b>{{ quality_warnings }}</b><span>Avisos de calidad</span></div>
  <div class="fact"><b>{{ fx | length }}</b><span>Divisas</span></div>
  <div class="fact"><b>{{ sample.companies | length }}</b><span>Ejemplos</span></div>
</div>

<div class="board">
  <section class="tile">
    <div class="tile-head"><h2>Empresas</h2><a href="reales/index.html">Ver todas →</a></div>
    <div class="scroll">
    <table>
      <thead><tr><th>Empresa</th><th>Sector</th><th class="num">Accionista</th><th class="num">Acreedor</th><th class="num">Alertas</th></tr></thead>
      <tbody>
      {% for company in study.run.companies %}
        <tr>
          <td><a href="reales/{{ company.ficha_path }}">{{ company.name }}</a></td>
          <td>{{ company.industry_label }}</td>
          <td class="num">{{ company.equity.value_text if company.equity.value is not none else "—" }}</td>
          <td class="num">{{ company.credit.value_text if company.credit.value is not none else "—" }}</td>
          <td class="num">{{ company.alerts | length or "" }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    </div>
  </section>
  <div class="stack">
    <section class="tile">
      <div class="tile-head"><h2>Divisas</h2><a href="divisas.html">Ver todas →</a></div>
      {% if fx %}
      <table>
        <thead><tr><th>Divisa</th><th class="num">Por euro</th><th class="num">1 mes</th><th>Último año</th></tr></thead>
        <tbody>
        {% for row in fx[:6] %}
          <tr><td class="code">{{ row.currency }}</td><td class="num">{{ row.rate_text }}</td>
            <td class="num {{ row.changes[1][1] }}">{{ row.changes[1][0] }}</td><td>{{ row.spark }}</td></tr>
        {% endfor %}
        </tbody>
      </table>
      {% else %}<p class="muted">Sin tipos de cambio en esta actualización.</p>{% endif %}
    </section>
    <section class="tile">
      <div class="tile-head"><h2>Alertas</h2><a href="reales/index.html">Ver empresas →</a></div>
      {% if real_alerts %}
      <ul class="alert-list">
        {% for company, alert in real_alerts %}
        <li><a href="reales/{{ company.ficha_path }}">{{ company.name }}</a> · <strong>{{ alert.rule_label }}.</strong> {{ alert.message }}</li>
        {% endfor %}
      </ul>
      {% else %}<p class="muted">Ninguna.</p>{% endif %}
    </section>
  </div>
</div>
{% endblock %}
