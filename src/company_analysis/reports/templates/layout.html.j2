<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% if site %}<meta name="robots" content="noindex, nofollow">{# the public website is reached by its link, not by search engines #}
{% endif %}
<title>{% block title %}{% endblock %}</title>
<style>
  :root {
    --bg: #ffffff; --text: #1d232b; --muted: #5d6773; --line: #d9dee4; --soft: #f3f5f7;
    --accent: #1f5f8b; --accent-soft: #e5eef5;
    --warn-bg: #fff4e0; --warn-text: #8a5300; --bad-bg: #fdecec; --bad-text: #9b1c1c;
    --ok-bg: #e9f6ee; --ok-text: #1e6b3a;
    --chart-grid: #e6ece8; --chart-median: #9aa7a0; --chart-dot: #0e7c4e;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #12161b; --text: #e4e8ed; --muted: #9aa5b1; --line: #2d353e; --soft: #1a2027;
      --accent: #7fb6df; --accent-soft: #1d2b38;
      --warn-bg: #362812; --warn-text: #f0c47e; --bad-bg: #3a1c1c; --bad-text: #f3a9a9;
      --ok-bg: #16301f; --ok-text: #93d8ab;
      --chart-grid: #26302b; --chart-median: #66756d; --chart-dot: #3fbf86;
      color-scheme: dark;
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text);
         font: 14px/1.45 "Segoe UI", system-ui, -apple-system, sans-serif; }
  main { max-width: 1180px; margin: 0 auto; padding: 24px 16px 48px; }
  h1 { font-size: 26px; margin: 4px 0 8px; text-wrap: balance; }
  h2 { font-size: 18px; margin: 28px 0 10px; padding-bottom: 6px; border-bottom: 2px solid var(--line); }
  h3 { font-size: 15px; margin: 20px 0 8px; }
  a { color: var(--accent); }
  .eyebrow { margin: 0; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; font-size: 12px; }
  .meta { margin: 2px 0; color: var(--muted); }
  .header { display: flex; justify-content: space-between; gap: 16px; align-items: flex-start; }
  .summary { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; margin: 20px 0 8px; }
  .card { border: 1px solid var(--line); border-radius: 8px; padding: 12px 14px; background: var(--soft); }
  .card-label { margin: 0; color: var(--muted); font-size: 12px; }
  .card-value { margin: 2px 0; font-size: 28px; font-weight: 600; }
  .card-muted .card-value { font-size: 18px; color: var(--muted); }
  .card-note { margin: 0; color: var(--muted); font-size: 12px; }
  .views { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
  .views > section { min-width: 0; overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; margin: 6px 0 12px; }
  th, td { padding: 6px 8px; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
  th { background: var(--soft); font-weight: 600; font-size: 12px; color: var(--muted); }
  .num { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
  tr.reason td { border-bottom: 1px solid var(--line); padding-top: 0; color: var(--muted); font-size: 12px; }
  tr.reason + tr td { border-top: none; }
  .badge { display: inline-block; padding: 1px 7px; border-radius: 10px; font-size: 12px;
           background: var(--warn-bg); color: var(--warn-text); white-space: nowrap; }
  .badge-pass { background: var(--ok-bg); color: var(--ok-text); }
  .badge-fail { background: var(--bad-bg); color: var(--bad-text); }
  .muted { color: var(--muted); }
  .scroll { overflow-x: auto; }
  .small { font-size: 12px; }
  .alerts li { margin-bottom: 6px; }
  details { margin: 6px 0; }
  summary { cursor: pointer; color: var(--accent); }
  dl.inputs { display: grid; grid-template-columns: max-content 1fr; gap: 2px 12px; margin: 6px 0 12px 16px; font-size: 12px; }
  dl.inputs dt { color: var(--muted); }
  dl.inputs dd { margin: 0; font-variant-numeric: tabular-nums; }
  .disclaimer { margin-top: 32px; padding: 12px 14px; border-left: 4px solid var(--accent); background: var(--soft); }
  footer { margin-top: 16px; color: var(--muted); font-size: 12px; }
  /* Website navigation (only on the public website) */
  .site { background: var(--soft); border-bottom: 1px solid var(--line); }
  .site-inner { max-width: 1180px; margin: 0 auto; padding: 10px 16px; display: flex; flex-wrap: wrap;
                align-items: center; gap: 6px 20px; }
  .brand { font-weight: 700; color: var(--text); text-decoration: none; font-size: 15px; }
  .site nav { display: flex; flex-wrap: wrap; gap: 4px; }
  .site nav a { padding: 5px 10px; border-radius: 6px; text-decoration: none; color: var(--muted); }
  .site nav a:hover { color: var(--text); background: var(--accent-soft); }
  .site nav a[aria-current="page"] { color: var(--accent); background: var(--accent-soft); font-weight: 600; }
  .site-notice { background: var(--accent-soft); color: var(--text); font-size: 13px; }
  .site-notice .site-inner { padding-top: 8px; padding-bottom: 8px; }
  @media (max-width: 860px) { .views { grid-template-columns: 1fr; } .header { flex-direction: column; } }
  @media print { main { max-width: none; padding: 0; } a.back, .site, .site-notice { display: none; } details { display: none; } }
</style>
</head>
<body>
{% if site %}
<header class="site">
  <div class="site-inner">
    <a class="brand" href="{{ site_root }}index.html">Análisis de empresas</a>
    <nav aria-label="Secciones">
      {% for key, label, href in site.links %}
      <a href="{{ site_root }}{{ href }}"{% if key == site.active %} aria-current="page"{% endif %}>{{ label }}</a>
      {% endfor %}
    </nav>
  </div>
</header>
{% if site.notice %}<div class="site-notice"><div class="site-inner">{{ site.notice }}</div></div>{% endif %}
{% endif %}
<main>
{% block content %}{% endblock %}
{% block footer %}{% endblock %}
</main>
</body>
</html>
