{% extends "web_base.html.j2" %}
{% block title %}Índices{% endblock %}
{% block content %}
<style>
  .ix { display: grid; gap: 16px; margin-top: 14px; }
  .ix-two { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; }  /* full width: every column fits */
  .tv { min-height: 120px; }
</style>

<div class="panel-head">
  <div><p class="eyebrow">Mercados</p><h1>Índices</h1></div>
  <span class="muted small">Datos de TradingView, con el retraso propio de cada mercado</span>
</div>

<div class="ix">
  <section class="panel-card">
    <div class="panel-head"><h2>Principales índices</h2></div>
    <div class="tv" data-tv="symbol-overview" style="height:460px"><script type="application/json">
      {"symbols": [["IBEX 35", "BME:IBC|1D"], ["Euro Stoxx 50", "PEPPERSTONE:EUSTX50|1D"], ["DAX", "XETR:DAX|1D"],
                   ["S&P 500", "FOREXCOM:SPXUSD|1D"], ["Nasdaq 100", "FOREXCOM:NSXUSD|1D"]],
       "chartOnly": false, "width": "100%", "height": "100%", "autosize": true, "showVolume": false, "showMA": false,
       "hideDateRanges": false, "hideMarketStatus": false, "hideSymbolLogo": false, "scalePosition": "right",
       "scaleMode": "Normal", "fontSize": "10", "noTimeScale": false, "valuesTracking": "1",
       "changeMode": "price-and-percent", "chartType": "area", "lineWidth": 2, "lineType": 0,
       "dateRanges": ["1d|1", "1m|30", "3m|60", "12m|1D", "60m|1W", "all|1M"]}
    </script></div>
  </section>

  <div class="ix-two">
    <section class="panel-card">
      <div class="panel-head"><h2>Cotizaciones</h2></div>
      <div class="tv" data-tv="market-quotes" style="height:640px"><script type="application/json">
        {"width": "100%", "height": "100%", "showSymbolLogo": true, "symbolsGroups": [
          {"name": "@europa", "symbols": [
            {"name": "BME:IBC", "displayName": "IBEX 35"}, {"name": "PEPPERSTONE:EUSTX50", "displayName": "Euro Stoxx 50"},
            {"name": "XETR:DAX", "displayName": "DAX"}, {"name": "PEPPERSTONE:FRA40", "displayName": "CAC 40"},
            {"name": "PEPPERSTONE:UK100", "displayName": "FTSE 100"}, {"name": "CAPITALCOM:IT40", "displayName": "FTSE MIB"}]},
          {"name": "@america-asia", "symbols": [
            {"name": "FOREXCOM:SPXUSD", "displayName": "S&P 500"}, {"name": "FOREXCOM:NSXUSD", "displayName": "Nasdaq 100"},
            {"name": "FOREXCOM:DJI", "displayName": "Dow Jones"}, {"name": "PEPPERSTONE:JPN225", "displayName": "Nikkei 225"},
            {"name": "PEPPERSTONE:HK50", "displayName": "Hang Seng"}]},
          {"name": "@materias", "symbols": [
            {"name": "TVC:UKOIL", "displayName": "Brent"}, {"name": "TVC:USOIL", "displayName": "WTI"},
            {"name": "TVC:GOLD", "displayName": "@oro"}, {"name": "TVC:SILVER", "displayName": "@plata"},
            {"name": "CAPITALCOM:NATURALGAS", "displayName": "@gas"}, {"name": "CAPITALCOM:COPPER", "displayName": "@cobre"}]},
          {"name": "@renta-fija", "symbols": [
            {"name": "EUREX:FGBL1!", "displayName": "@bund"}]}
        ]}
      </script></div>
    </section>
    <section class="panel-card">
      <div class="panel-head"><h2>Valores del IBEX 35</h2></div>
      <div class="tv" data-tv="market-quotes" style="height:640px"><script type="application/json">
        {"width": "100%", "height": "100%", "showSymbolLogo": true, "symbolsGroups": [
          {"name": "@grandes-valores", "symbols": [
            {"name": "BME:SAN", "displayName": "Santander"}, {"name": "BME:BBVA", "displayName": "BBVA"},
            {"name": "BME:ITX", "displayName": "Inditex"}, {"name": "BME:IBE", "displayName": "Iberdrola"},
            {"name": "BME:CABK", "displayName": "CaixaBank"}, {"name": "BME:TEF", "displayName": "Telefónica"},
            {"name": "BME:REP", "displayName": "Repsol"}, {"name": "BME:AENA", "displayName": "Aena"},
            {"name": "BME:AMS", "displayName": "Amadeus"}, {"name": "BME:IAG", "displayName": "IAG"},
            {"name": "BME:ACS", "displayName": "ACS"}, {"name": "BME:ELE", "displayName": "Endesa"},
            {"name": "BME:NTGY", "displayName": "Naturgy"}, {"name": "BME:CLNX", "displayName": "Cellnex"},
            {"name": "BME:SAB", "displayName": "Banco Sabadell"}, {"name": "BME:BKT", "displayName": "Bankinter"},
            {"name": "BME:MAP", "displayName": "Mapfre"}, {"name": "BME:GRF", "displayName": "Grifols"}]}
        ]}
      </script></div>
    </section>
  </div>

  <section class="panel-card">
    <div class="panel-head"><h2>Mapa del IBEX 35</h2><span class="muted small">Tamaño según capitalización; color según la variación del día</span></div>
    <div class="tv" data-tv="stock-heatmap" style="height:520px"><script type="application/json">
      {"exchanges": [], "dataSource": "IBEX35", "grouping": "sector", "blockSize": "market_cap_basic",
       "blockColor": "change", "hasTopBar": false, "isDataSetEnabled": false, "isZoomEnabled": true,
       "hasSymbolTooltip": true, "width": "100%", "height": "100%"}
    </script></div>
  </section>
</div>

<div hidden>
  <span data-texto="europa">Europa</span>
  <span data-texto="america-asia">América y Asia</span>
  <span data-texto="materias">Materias primas</span>
  <span data-texto="renta-fija">Renta fija</span>
  <span data-texto="grandes-valores">Grandes valores</span>
  <span data-texto="oro">Oro</span>
  <span data-texto="plata">Plata</span>
  <span data-texto="gas">Gas natural</span>
  <span data-texto="cobre">Cobre</span>
  <span data-texto="bund">Futuro del Bund alemán</span>
</div>
{% endblock %}
