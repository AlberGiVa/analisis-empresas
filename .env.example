# Copia este fichero como .env y ajusta los valores. El .env nunca se sube al repositorio.
# Las rutas relativas se interpretan desde la carpeta del proyecto.

# Base de datos local (DuckDB)
ANALYSIS_DB_PATH=data/analysis.duckdb
# Carpeta donde se generan las fichas y el ranking
ANALYSIS_OUTPUT_DIR=output
# Configuración de la metodología (factores, pesos, umbrales, filtros y alertas)
ANALYSIS_CONFIG_PATH=config/analysis.yaml
# Datos sintéticos de ejemplo
ANALYSIS_SAMPLE_DATA_DIR=data/sample

# Credenciales de proveedores de datos: se usarán cuando se conecten Bloomberg o FactSet.
# Nunca escribas claves reales en este fichero de ejemplo.
# ANALYSIS_FACTSET_USERNAME=
# ANALYSIS_FACTSET_API_KEY=
